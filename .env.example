# Chronos local development environment (Phase 5: docker compose).
#
# Copy this file to .env (gitignored -- see .gitignore's "Environment /
# secrets" section) and adjust if needed. Every value below is a safe
# LOCAL DEVELOPMENT default, not a real secret -- do not reuse any of
# these outside your own machine.
#
#   cp .env.example .env
#   docker compose up --build
#
# docker compose automatically loads a root-level .env file for variable
# substitution in docker-compose.yml, and each service also gets these
# passed through via `env_file: .env`.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
CHRONOS_POSTGRES_USER=chronos
CHRONOS_POSTGRES_PASSWORD=chronos_dev_password
CHRONOS_POSTGRES_DB=chronos
# Host port PostgreSQL is published on (container always uses 5432
# internally) -- lets you point psql/DBeaver/etc at localhost.
CHRONOS_POSTGRES_HOST_PORT=5432

# docker-compose.yml derives CHRONOS_DATABASE_URL for every backend
# service from the three values above (host "postgres" is the service
# name on the internal compose network -- not reachable from your host
# directly; use localhost:${CHRONOS_POSTGRES_HOST_PORT} with the same
# credentials for that instead). Deriving it in one place, rather than
# duplicating a second full connection string here, means changing the
# password above can't drift out of sync with it.

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
CHRONOS_RABBITMQ_USER=chronos
CHRONOS_RABBITMQ_PASSWORD=chronos_dev_password
# Host ports: 5672 = AMQP, 15672 = management UI
# (http://localhost:15672, login with the credentials above).
CHRONOS_RABBITMQ_HOST_PORT=5672
CHRONOS_RABBITMQ_MANAGEMENT_HOST_PORT=15672

# docker-compose.yml derives CHRONOS_RABBITMQ_URL from the two values
# above the same way (see the PostgreSQL note above).

# Every task type the relay should declare topology for at startup (see
# relay/__main__.py). Must list every type any worker service consumes.
CHRONOS_TASK_TYPES=echo,sleep,http_request,python_expression

# ---------------------------------------------------------------------------
# Redis (optional per-task-type concurrency limiter -- fail-open, ephemeral)
# ---------------------------------------------------------------------------
CHRONOS_REDIS_HOST_PORT=6379
# docker-compose.yml sets CHRONOS_REDIS_URL to redis://redis:6379/0 for
# worker-* services directly (no credentials involved -- the redis image
# runs with no auth in this local dev setup).
# Set to 1 to have worker-* services construct the limiter. Off by
# default, matching worker/__main__.py's own pre-existing default.
CHRONOS_REDIS_LIMITER_ENABLED=0

# ---------------------------------------------------------------------------
# Autoscaler (policy-based worker autoscaling -- see autoscaler/ and the
# "Autoscaling" section of README.md)
# ---------------------------------------------------------------------------
# Master switch. When 1/true the `autoscaler` compose service observes each
# task type's backlog (READY tasks in PostgreSQL) and scales that task
# type's worker service between MIN and MAX replicas. Off -> the service
# idles harmlessly. Enabled here so `docker compose up` demonstrates it.
CHRONOS_AUTOSCALER_ENABLED=1
# Seconds between observations.
CHRONOS_AUTOSCALER_INTERVAL=10
# Hard replica bounds; desired is always clamped into [MIN, MAX].
CHRONOS_AUTOSCALER_MIN_REPLICAS=1
CHRONOS_AUTOSCALER_MAX_REPLICAS=5
# Anti-thrash. Scale UP only after the higher target holds for this many
# consecutive observations (fast); scale DOWN only after the queue has
# stayed quiet for this many seconds (slow). Up faster than down, on purpose.
CHRONOS_AUTOSCALER_SCALE_UP_STABILIZATION=2
CHRONOS_AUTOSCALER_SCALE_DOWN_COOLDOWN=60
# Backlog -> desired replicas step table: "<min_backlog>:<replicas>,...".
# Default below matches the documented tiers (0-2->1, 3-5->2, 6-10->3,
# 11-20->4, 21+->5). Leave unset to use it.
# CHRONOS_AUTOSCALER_BACKLOG_TIERS=0:1,3:2,6:3,11:4,21:5
# Which task types to manage. Defaults to CHRONOS_TASK_TYPES above.
# CHRONOS_AUTOSCALER_TASK_TYPES=echo,sleep,http_request,python_expression
# Compose service name = <prefix><task_type> (worker-echo, worker-sleep, ...).
# CHRONOS_AUTOSCALER_SERVICE_PREFIX=worker-
# Compose project to scale. Unset -> auto-detected from the autoscaler's own
# container label (recommended). Set only if you run compose with a custom -p.
# CHRONOS_AUTOSCALER_COMPOSE_PROJECT=chronos

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Required, no default (see api/config.py) -- change this if you ever
# point this compose file at anything beyond your own machine.
CHRONOS_JWT_SECRET=dev-only-insecure-secret-change-me
CHRONOS_API_HOST_PORT=8000
CHRONOS_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
CHRONOS_FRONTEND_HOST_PORT=5173
# What the browser (not other containers) uses to reach the API -- must
# be host-reachable, so localhost + the published API port, not the
# "api" service name.
VITE_CHRONOS_API_URL=http://localhost:8000
