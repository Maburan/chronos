# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/
*.egg-info/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node / frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.local

# --- Environment / secrets ---
# Never commit real credentials. .env.example (or any .env.*.example) is
# intentionally exempted so documented placeholder variables stay tracked.
.env
.env.*
!.env.example
!.env.*.example

# --- IDE / editor ---
.vscode/
!.vscode/extensions.json
.idea/
.claude/
*.swp
*.swo

# --- OS junk ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Logs / local runtime artifacts ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
